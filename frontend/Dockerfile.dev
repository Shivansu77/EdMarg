# Development image for the EdMarg frontend.
# Runs `next dev` with the source bind-mounted at /app for fast refresh.
FROM node:24-alpine

WORKDIR /app

# Install dependencies first so this layer is cached until package files change.
COPY package*.json ./

RUN npm install

EXPOSE 3000

# next dev binds to 0.0.0.0 by default, exposing it to the host.
CMD ["npm", "run", "dev"]
